# Environment
ENVIRONMENT=development
DEBUG=true

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Comma-separated list of additional allowed CORS origins for the public
# Security Signals widget (e.g. the Securacy.AI domain(s) once known).
# Leave empty to keep using FRONTEND_URL alone. Never commit a real
# production domain here - set this via deploy-time environment config.
CORS_ALLOWED_ORIGINS=

# Database (Docker Compose will provide postgres:5432)
DATABASE_URL=postgresql://securitysignals:securitysignals@postgres:5432/security_signals

# API Keys
ANTHROPIC_API_KEY=your-key-here

# JWT
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Ingestion
INGESTION_TIMEOUT_SECONDS=30
INGESTION_MAX_RETRIES=3
INGESTION_MAX_RESPONSE_SIZE_MB=10

# Logging
LOG_LEVEL=INFO

# Microsoft Entra ID sign-in (backend-driven OIDC authorization-code flow).
# Real values go in your untracked .env / deployment secret store ONLY -
# never in source, never in frontend env, never committed. The client secret
# is read by the backend alone and is never sent to the browser.
ENTRA_ENABLED=false
# Directory (tenant) ID and Application (client) ID GUIDs from the app registration.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Must EXACTLY match a redirect URI registered on the app registration.
ENTRA_REDIRECT_URI=http://localhost:8000/api/v1/auth/entra/callback
# Where the browser lands after sign-in (also used for the login-error redirect).
FRONTEND_URL=http://localhost:5173
# Application access is restricted by the Security Signals Enterprise
# Application's own "user assignment required" setting in the Entra/Azure
# portal (not by any setting here) - an unassigned user's sign-in is
# rejected by Microsoft itself. There is also no auto-provisioning: every
# authorized user must already have an internal User record (role assigned
# via existing user management) before their first Entra sign-in.
# One-time link of an existing internal account with the same email to the Entra object ID.
ENTRA_LINK_EXISTING_USERS_BY_EMAIL=true
# Lifetime (hours) of the app session issued after an Entra sign-in.
ENTRA_SESSION_HOURS=8
# Set false to make Entra the only way in (disables the temporary password login).
LOCAL_LOGIN_ENABLED=true

# Resend - reviewer-notification email on signal submit-for-review
# (DRAFT -> IN_REVIEW). Real value goes in your untracked .env /
# deployment secret store ONLY - never in source, never committed.
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@securacy.ai
# Used by an existing, separate organization-approval flow - not read by
# the reviewer-notification code path.
ORG_APPROVAL_EMAIL=hello@securacy.ai
